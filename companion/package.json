{
  "name": "@overlaykit/companion",
  "version": "0.1.0",
  "description": "Vendor-neutral OverlayKit control adapter: projects the authorized Control API action catalog into Bitfocus Companion action definitions, with no Elgato or hardware SDK dependency.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Rodrigo Vicente",
    "url": "https://x.com/rodrigoteamx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OverlayKit/overlaykit.git",
    "directory": "companion"
  },
  "homepage": "https://github.com/OverlayKit/overlaykit#readme",
  "bugs": {
    "url": "https://github.com/OverlayKit/overlaykit/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@overlaykit/protocol": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
